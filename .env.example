# Server
SERVER_PORT=8080

# Database
DB_URL=jdbc:mysql://localhost:3306/aivira?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Ho_Chi_Minh&characterEncoding=utf8mb4&useUnicode=true
USERNAME_DB=root
PASSWORD_DB=

# Schema management
FLYWAY_ENABLED=true
FLYWAY_LOCATIONS=classpath:db/migration
FLYWAY_BASELINE_ON_MIGRATE=false
DDL_AUTO=validate
SHOW_SQL=false

# JWT
JWT_SIGNER_KEY=
JWT_ISSUER=aivira.com
JWT_VALID_DURATION=3600
JWT_REFRESHABLE_DURATION=36000

# Security / CORS
PUBLIC_ENDPOINTS=/oauth2/**,/auth/token,/auth/register,/auth/verify-user,/auth/resend-verification,/auth/forgot-password,/auth/reset-password,/auth/refresh-token,/auth/logout,/categories,/categories/**,/products,/products/**,/payments/vnpay/return,/payments/vnpay/ipn,/payments/momo/ipn,/swagger-ui.html,/swagger-ui/**,/v3/api-docs,/v3/api-docs/**,/v3/api-docs.yaml,/api/v1/auth/token,/api/v1/auth/register,/api/v1/auth/verify-user,/api/v1/auth/resend-verification,/api/v1/auth/forgot-password,/api/v1/auth/reset-password,/api/v1/auth/refresh-token,/api/v1/auth/logout,/api/v1/categories,/api/v1/categories/**,/api/v1/products,/api/v1/products/**,/api/v1/payments/vnpay/return,/api/v1/payments/vnpay/ipn,/api/v1/payments/momo/ipn,/api/v1/swagger-ui.html,/api/v1/swagger-ui/**,/api/v1/v3/api-docs,/api/v1/v3/api-docs/**,/api/v1/v3/api-docs.yaml
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type,Accept,Origin,X-Requested-With

# Auth
AUTH_REFRESH_TOKEN_BODY_ENABLED=true
AUTH_REFRESH_TOKEN_COOKIE_NAME=refreshToken
AUTH_REFRESH_TOKEN_COOKIE_PATH=/api/v1/auth
AUTH_REFRESH_TOKEN_COOKIE_SAME_SITE=Lax
AUTH_REFRESH_TOKEN_COOKIE_SECURE=true
AUTH_REFRESH_TOKEN_COOKIE_HTTP_ONLY=true
AUTH_BRUTE_FORCE_MAX_ATTEMPTS=5
AUTH_BRUTE_FORCE_WINDOW_MINUTES=15
AUTH_BRUTE_FORCE_LOCK_MINUTES=15
AUTH_CLEANUP_CRON=0 0 * * * *
AUTH_CLEANUP_OTP_USED_RETENTION_HOURS=24

# Mail
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
MAIL_FROM=tavantien786@gmail.com
MAIL_FROM_NAME=Aivira Store

# Upload / Cloudinary
APP_UPLOAD_ENABLED=true
APP_UPLOAD_MAX_IMAGE_SIZE=5242880
APP_UPLOAD_MAX_DOCUMENT_SIZE=10485760
APP_UPLOAD_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/gif,image/webp
APP_UPLOAD_ALLOWED_DOCUMENT_TYPES=application/pdf
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_SECURE=true
CLOUDINARY_AVATAR_FOLDER=aivira/users
CLOUDINARY_PRODUCT_MEDIA_FOLDER=aivira/products

# Payment
PAYMENT_PENDING_TTL_MINUTES=15
PAYMENT_EXPIRY_SCAN_DELAY_MS=60000
PAYMENT_PROVIDER_CONNECT_TIMEOUT_MS=5000
PAYMENT_PROVIDER_READ_TIMEOUT_MS=30000

# VNPay sandbox
VNPAY_ENABLED=false
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_TRANSACTION_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=http://localhost:8080/api/v1/payments/vnpay/return
VNPAY_IPN_URL=http://localhost:8080/api/v1/payments/vnpay/ipn

# MoMo sandbox
MOMO_ENABLED=false
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_QUERY_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/query
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_REDIRECT_URL=http://localhost:3000/payment/momo/return
MOMO_IPN_URL=http://localhost:8080/api/v1/payments/momo/ipn
MOMO_REQUEST_TYPE=payWithMethod

# Optional local seed
SEED_ENABLED=false
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_EMAIL=
