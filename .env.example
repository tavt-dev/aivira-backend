# Runtime
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

# Database
DB_URL=jdbc:mysql://localhost:3306/aivira?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Ho_Chi_Minh&characterEncoding=UTF-8&useUnicode=true
USERNAME_DB=root
PASSWORD_DB=

# Schema management
FLYWAY_ENABLED=true
FLYWAY_LOCATIONS=classpath:db/migration
FLYWAY_BASELINE_ON_MIGRATE=false
DDL_AUTO=validate
SHOW_SQL=false

# JWT
JWT_SIGNER_KEY=
JWT_ISSUER=aivira.com
JWT_VALID_DURATION=3600
JWT_REFRESHABLE_DURATION=36000

# Security / CORS
PUBLIC_ENDPOINTS=/oauth2/**,/auth/token,/auth/register,/auth/verify-user,/auth/resend-verification,/auth/forgot-password,/auth/reset-password,/auth/refresh-token,/auth/logout,/auth/google/**,/categories,/categories/**,/products,/products/**,/blog/**,/storefront/**,/payments/vnpay/return,/payments/vnpay/ipn,/payments/momo/return,/payments/momo/ipn,/actuator/health,/swagger-ui.html,/swagger-ui/**,/v3/api-docs,/v3/api-docs/**,/v3/api-docs.yaml,/api/v1/auth/token,/api/v1/auth/register,/api/v1/auth/verify-user,/api/v1/auth/resend-verification,/api/v1/auth/forgot-password,/api/v1/auth/reset-password,/api/v1/auth/logout,/api/v1/auth/refresh-token,/api/v1/auth/google/**,/api/v1/categories,/api/v1/categories/**,/api/v1/products,/api/v1/products/**,/api/v1/blog/**,/api/v1/storefront/**,/api/v1/payments/vnpay/return,/api/v1/payments/vnpay/ipn,/api/v1/payments/momo/return,/api/v1/payments/momo/ipn,/api/v1/actuator/health,/api/v1/swagger-ui.html,/api/v1/swagger-ui/**,/api/v1/v3/api-docs,/api/v1/v3/api-docs/**,/api/v1/v3/api-docs.yaml
CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type,Accept,Origin,X-Requested-With

# Auth
AUTH_REFRESH_TOKEN_BODY_ENABLED=true
AUTH_REFRESH_TOKEN_COOKIE_NAME=refreshToken
AUTH_REFRESH_TOKEN_COOKIE_PATH=/api/v1/auth
AUTH_REFRESH_TOKEN_COOKIE_SAME_SITE=Lax
AUTH_REFRESH_TOKEN_COOKIE_SECURE=true
AUTH_REFRESH_TOKEN_COOKIE_HTTP_ONLY=true
AUTH_BRUTE_FORCE_MAX_ATTEMPTS=5
AUTH_BRUTE_FORCE_WINDOW_MINUTES=15
AUTH_BRUTE_FORCE_LOCK_MINUTES=15
AUTH_CLEANUP_CRON=0 0 * * * *
AUTH_CLEANUP_OTP_USED_RETENTION_HOURS=24
AUTH_CLEANUP_OAUTH_USED_RETENTION_HOURS=1

# Google OAuth login
# Set GOOGLE_OAUTH_ENABLED=true only after client id/secret and redirect URI are configured in Google Cloud Console.
GOOGLE_OAUTH_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback
GOOGLE_OAUTH_SCOPES=openid email profile
GOOGLE_OAUTH_FRONTEND_SUCCESS_URL=http://localhost:5173/auth/google/success
GOOGLE_OAUTH_FRONTEND_FAILURE_URL=http://localhost:5173/auth/google/failure
GOOGLE_OAUTH_STATE_TTL_SECONDS=300
GOOGLE_OAUTH_TICKET_TTL_SECONDS=300
GOOGLE_OAUTH_AUTHORIZATION_URI=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_OAUTH_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_OAUTH_ISSUER_URI=https://accounts.google.com

# Mail / Brevo Transactional Email API
BREVO_API_KEY=
BREVO_BASE_URL=https://api.brevo.com
BREVO_SEND_EMAIL_PATH=/v3/smtp/email
BREVO_CONNECT_TIMEOUT_MS=5000
BREVO_READ_TIMEOUT_MS=10000
MAIL_FROM=
MAIL_FROM_NAME=Aivira Store

# Upload / Cloudinary
APP_UPLOAD_ENABLED=true
APP_UPLOAD_MAX_IMAGE_SIZE=5242880
APP_UPLOAD_MAX_DOCUMENT_SIZE=10485760
APP_UPLOAD_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/gif,image/webp
APP_UPLOAD_ALLOWED_DOCUMENT_TYPES=application/pdf
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_SECURE=true
CLOUDINARY_AVATAR_FOLDER=aivira/users
CLOUDINARY_PRODUCT_MEDIA_FOLDER=aivira/products
CLOUDINARY_REVIEW_IMAGE_FOLDER=aivira/reviews
CLOUDINARY_BLOG_IMAGE_FOLDER=aivira/blog
SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=5MB
SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE=26MB

# Payment
PAYMENT_PENDING_TTL_MINUTES=15
PAYMENT_EXPIRY_SCAN_DELAY_MS=60000
PAYMENT_PROVIDER_CONNECT_TIMEOUT_MS=5000
PAYMENT_PROVIDER_READ_TIMEOUT_MS=30000
PAYMENT_FRONTEND_RESULT_URL=http://localhost:5173/payment-result

# VNPay sandbox
VNPAY_ENABLED=false
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_TRANSACTION_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=http://localhost:8080/api/v1/payments/vnpay/return
VNPAY_IPN_URL=http://localhost:8080/api/v1/payments/vnpay/ipn

# MoMo sandbox
MOMO_ENABLED=false
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_QUERY_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/query
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_REDIRECT_URL=http://localhost:8080/api/v1/payments/momo/return
MOMO_IPN_URL=http://localhost:8080/api/v1/payments/momo/ipn
MOMO_REQUEST_TYPE=payWithMethod

# Optional local seed
SEED_ENABLED=false
SEED_DEMO_CATALOG_ENABLED=false
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_EMAIL=
