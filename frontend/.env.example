# Frontend API base URL.
# In local Vite dev, keep /api/v1 so requests go through vite.config.js proxy.
# For deployed frontend, set this to the backend API origin, e.g. https://api.example.com/api/v1.
VITE_API_BASE_URL=/api/v1

# Backend endpoint that starts Google OAuth login. Keep /api/v1 with Vite proxy in local dev.
VITE_GOOGLE_OAUTH_AUTHORIZE_URL=/api/v1/auth/google/authorize
