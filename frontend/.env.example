# All VITE_* values are public build-time frontend config. Do not put secrets here.
#
# Same-origin local/dev and reverse-proxy production:
# keep /api/v1 so browser requests stay on the frontend origin and are proxied.
#
# Split frontend/backend domains:
# set VITE_API_BASE_URL=https://backend-domain.example.com/api/v1
VITE_API_BASE_URL=/api/v1

# Local Vite dev proxy target for /api/**.
# Used only by vite.config.js during npm run dev.
VITE_DEV_PROXY_TARGET=http://localhost:8080
