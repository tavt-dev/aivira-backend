{
  "name": "aivira-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "quality": "npm run build && npm run test",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier \"README.md\" \"../README.md\" \"*.config.js\" \"*.{json,md}\" \"tests/**/*.{js,jsx}\" \"src/**/*.test.{js,jsx}\" \"src/test/**/*.{js,jsx}\" --write --no-error-on-unmatched-pattern",
    "format:check": "prettier \"README.md\" \"../README.md\" \"*.config.js\" \"*.{json,md}\" \"tests/**/*.{js,jsx}\" \"src/**/*.test.{js,jsx}\" \"src/test/**/*.{js,jsx}\" --check --no-error-on-unmatched-pattern",
    "ci": "npm run build && npm run test && npm run test:e2e && npm run lint && npm run format:check"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "gsap": "^3.15.0",
    "i18next": "^26.3.0",
    "lucide-react": "^1.17.0",
    "motion": "^12.40.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.8",
    "react-router-dom": "^6.28.0",
    "recharts": "^3.8.1",
    "vite": "^5.4.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.53.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitest/coverage-v8": "^3.2.6",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "msw": "^2.10.2",
    "postcss": "^8.4.49",
    "prettier": "^3.8.4",
    "tailwindcss": "^3.4.17",
    "vitest": "^3.2.4"
  }
}
