{
  "info": {
    "_postman_id": "7f15a69d-72c6-4e2d-aivira-backend",
    "name": "Aivira Backend API",
    "description": "Postman collection for the Aivira single-vendor bookstore backend. Import Aivira_Backend.postman_environment.json and run Login first to populate accessToken.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login response is successful', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "if (json && json.data) {",
                  "  if (json.data.accessToken) pm.environment.set('accessToken', json.data.accessToken);",
                  "  if (json.data.refreshToken) pm.environment.set('refreshToken', json.data.refreshToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/token",
            "description": "Login and save accessToken/refreshToken into the active Postman environment."
          }
        },
        {
          "name": "Register",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"postman_user\",\n  \"password\": \"Password123!\",\n  \"email\": \"postman_user@example.com\",\n  \"firstName\": \"Postman\",\n  \"lastName\": \"User\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" },
            "url": "{{baseUrl}}/auth/refresh-token"
          }
        },
        {
          "name": "Logout",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" },
            "url": "{{baseUrl}}/auth/logout"
          }
        },
        {
          "name": "My Sessions",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
            "method": "GET",
            "url": "{{baseUrl}}/auth/sessions"
          }
        }
      ]
    },
    {
      "name": "Public Catalog",
      "item": [
        {
          "name": "List Products / Books",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{baseUrl}}/products?keyword=clean&categorySlug={{categorySlug}}&author=Robert&publisher=Prentice&isbn=978&available=true&sort=name_asc&page=1&size=20"
          }
        },
        {
          "name": "Get Product / Book Detail",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{baseUrl}}/products/{{productSlug}}"
          }
        },
        {
          "name": "Categories",
          "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{baseUrl}}/categories" }
        },
        {
          "name": "Category Tree",
          "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{baseUrl}}/categories/tree" }
        },
        {
          "name": "Storefront Home",
          "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{baseUrl}}/storefront/home" }
        },
        {
          "name": "Public Product Reviews",
          "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{baseUrl}}/products/{{productSlug}}/reviews?rating=5&page=1&size=10&sort=newest" }
        }
      ]
    },
    {
      "name": "Customer Profile",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
      "item": [
        { "name": "Me", "request": { "method": "GET", "url": "{{baseUrl}}/users/me" } },
        {
          "name": "Update Me",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"firstName\": \"Postman\",\n  \"lastName\": \"Tester\",\n  \"gender\": \"MALE\"\n}" },
            "url": "{{baseUrl}}/users/me"
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"currentPassword\": \"Password123!\",\n  \"newPassword\": \"NewPassword123!\",\n  \"confirmPassword\": \"NewPassword123!\"\n}" },
            "url": "{{baseUrl}}/users/me/password"
          }
        }
      ]
    },
    {
      "name": "Addresses",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
      "item": [
        { "name": "List Addresses", "request": { "method": "GET", "url": "{{baseUrl}}/users/me/addresses" } },
        {
          "name": "Create Address",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const json = pm.response.json();", "if (json && json.data && json.data.id) pm.environment.set('addressId', json.data.id);"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"recipientName\": \"Postman User\",\n  \"phoneNumber\": \"0900000000\",\n  \"addressLine\": \"123 Nguyen Hue\",\n  \"ward\": \"Ben Nghe\",\n  \"district\": \"District 1\",\n  \"city\": \"Ho Chi Minh\",\n  \"defaultAddress\": true\n}" },
            "url": "{{baseUrl}}/users/me/addresses"
          }
        },
        { "name": "Set Default Address", "request": { "method": "PUT", "url": "{{baseUrl}}/users/me/addresses/{{addressId}}/default" } }
      ]
    },
    {
      "name": "Cart And Checkout",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
      "item": [
        { "name": "Get Cart", "request": { "method": "GET", "url": "{{baseUrl}}/cart" } },
        {
          "name": "Add Cart Item",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const json = pm.response.json();", "if (json && json.data && json.data.items && json.data.items.length) pm.environment.set('cartItemId', json.data.items[0].id);"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"productVariationId\": {{variationId}},\n  \"quantity\": 1\n}" },
            "url": "{{baseUrl}}/cart/items"
          }
        },
        {
          "name": "Update Cart Item",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"quantity\": 2\n}" },
            "url": "{{baseUrl}}/cart/items/{{cartItemId}}"
          }
        },
        {
          "name": "Checkout Preview",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"addressId\": {{addressId}},\n  \"cartItemIds\": [{{cartItemId}}],\n  \"paymentMethod\": \"COD\",\n  \"couponCode\": \"{{couponCode}}\",\n  \"notes\": \"Postman checkout preview\"\n}" },
            "url": "{{baseUrl}}/checkout/preview"
          }
        },
        {
          "name": "Checkout",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json && json.data) {",
                  "  if (json.data.id) pm.environment.set('orderId', json.data.id);",
                  "  if (json.data.paymentGroupCode) pm.environment.set('paymentGroupCode', json.data.paymentGroupCode);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"addressId\": {{addressId}},\n  \"cartItemIds\": [{{cartItemId}}],\n  \"paymentMethod\": \"COD\",\n  \"couponCode\": \"{{couponCode}}\",\n  \"notes\": \"Postman checkout\"\n}" },
            "url": "{{baseUrl}}/checkout"
          }
        }
      ]
    },
    {
      "name": "Orders Payments Reviews",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
      "item": [
        { "name": "My Orders", "request": { "method": "GET", "url": "{{baseUrl}}/orders?page=1&size=20" } },
        { "name": "My Order Detail", "request": { "method": "GET", "url": "{{baseUrl}}/orders/{{orderId}}" } },
        {
          "name": "Cancel My Order",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"reason\": \"Customer changed mind\"\n}" },
            "url": "{{baseUrl}}/orders/{{orderId}}/cancel"
          }
        },
        { "name": "Payment Group Detail", "request": { "method": "GET", "url": "{{baseUrl}}/payments/groups/{{paymentGroupCode}}" } },
        { "name": "Payment Detail", "request": { "method": "GET", "url": "{{baseUrl}}/payments/{{paymentId}}" } },
        {
          "name": "Retry Payment",
          "request": { "method": "POST", "url": "{{baseUrl}}/payments/groups/{{paymentGroupCode}}/retry" }
        },
        {
          "name": "Create Review For Order Item",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const json = pm.response.json();", "if (json && json.data && json.data.id) pm.environment.set('reviewId', json.data.id);"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"rating\": 5,\n  \"comment\": \"Good book quality from Postman.\",\n  \"images\": []\n}" },
            "url": "{{baseUrl}}/orders/{{orderId}}/items/{{orderItemId}}/review"
          }
        },
        {
          "name": "Update Review",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"rating\": 4,\n  \"comment\": \"Updated review from Postman.\",\n  \"images\": []\n}" },
            "url": "{{baseUrl}}/reviews/{{reviewId}}"
          }
        },
        { "name": "Delete Review", "request": { "method": "DELETE", "url": "{{baseUrl}}/reviews/{{reviewId}}" } }
      ]
    },
    {
      "name": "Admin Categories Products",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
      "item": [
        {
          "name": "Create Category",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const json = pm.response.json();", "if (json && json.data) { if (json.data.id) pm.environment.set('categoryId', json.data.id); if (json.data.slug) pm.environment.set('categorySlug', json.data.slug); }"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"categoryName\": \"Postman Books\",\n  \"slug\": \"postman-books\",\n  \"description\": \"Created from Postman\",\n  \"displayOrder\": 99,\n  \"active\": true,\n  \"visible\": true\n}" },
            "url": "{{baseUrl}}/admin/categories"
          }
        },
        { "name": "Admin List Products", "request": { "method": "GET", "url": "{{baseUrl}}/admin/products?page=1&size=20&keyword=clean" } },
        {
          "name": "Create Product / Book",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const json = pm.response.json();", "if (json && json.data) { if (json.data.id) pm.environment.set('productId', json.data.id); if (json.data.slug) pm.environment.set('productSlug', json.data.slug); if (json.data.variations && json.data.variations.length) pm.environment.set('variationId', json.data.variations[0].id); }"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"sku\": \"BOOK-POSTMAN-001\",\n  \"productName\": \"Postman API Testing Book\",\n  \"slug\": \"postman-api-testing-book\",\n  \"description\": \"A demo book created from Postman.\",\n  \"bookAuthor\": \"Aivira Admin\",\n  \"isbn\": \"9780000000001\",\n  \"publisher\": \"Aivira Press\",\n  \"publicationYear\": 2026,\n  \"bookLanguage\": \"English\",\n  \"pageCount\": 256,\n  \"bookFormat\": \"PAPERBACK\",\n  \"dimensions\": \"14 x 21 cm\",\n  \"categoryId\": {{categoryId}},\n  \"price\": 250000,\n  \"originalPrice\": 300000,\n  \"discountPercentage\": 0,\n  \"weight\": 0.4,\n  \"variations\": [\n    {\n      \"sku\": \"BOOK-POSTMAN-001-PB\",\n      \"color\": \"Default\",\n      \"size\": \"Paperback\",\n      \"additionalPrice\": 0,\n      \"stockQuantity\": 20,\n      \"active\": true\n    }\n  ]\n}" },
            "url": "{{baseUrl}}/admin/products"
          }
        },
        {
          "name": "Update Product Stock",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"stockQuantity\": 25\n}" },
            "url": "{{baseUrl}}/admin/products/{{productId}}/variations/{{variationId}}/stock"
          }
        },
        { "name": "Admin Product Detail", "request": { "method": "GET", "url": "{{baseUrl}}/admin/products/{{productId}}" } }
      ]
    },
    {
      "name": "Admin Orders Refunds",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
      "item": [
        { "name": "Admin List Orders", "request": { "method": "GET", "url": "{{baseUrl}}/admin/orders?status=PENDING_CONFIRMATION&page=1&size=20" } },
        { "name": "Admin Order Detail", "request": { "method": "GET", "url": "{{baseUrl}}/admin/orders/{{orderId}}" } },
        { "name": "Confirm Order", "request": { "method": "PUT", "url": "{{baseUrl}}/admin/orders/{{orderId}}/confirm" } },
        { "name": "Mark Packing", "request": { "method": "PUT", "url": "{{baseUrl}}/admin/orders/{{orderId}}/packing" } },
        { "name": "Mark Shipping", "request": { "method": "PUT", "url": "{{baseUrl}}/admin/orders/{{orderId}}/shipping" } },
        { "name": "Mark Completed", "request": { "method": "PUT", "url": "{{baseUrl}}/admin/orders/{{orderId}}/completed" } },
        {
          "name": "Admin Cancel Order",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"reason\": \"Admin cancellation from Postman\"\n}" },
            "url": "{{baseUrl}}/admin/orders/{{orderId}}/cancel"
          }
        },
        {
          "name": "Mark Manual Refund",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"amount\": 250000,\n  \"reason\": \"Manual refund from Postman\",\n  \"note\": \"Provider refund API is not called.\"\n}" },
            "url": "{{baseUrl}}/admin/orders/{{orderId}}/mark-refunded"
          }
        }
      ]
    },
    {
      "name": "Admin Users RBAC",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
      "item": [
        { "name": "List Users", "request": { "method": "GET", "url": "{{baseUrl}}/admin/users?page=1&size=20&keyword=admin" } },
        { "name": "User Detail", "request": { "method": "GET", "url": "{{baseUrl}}/admin/users/{{userId}}" } },
        { "name": "Lock User", "request": { "method": "PUT", "url": "{{baseUrl}}/admin/users/{{userId}}/lock" } },
        { "name": "Unlock User", "request": { "method": "PUT", "url": "{{baseUrl}}/admin/users/{{userId}}/unlock" } },
        {
          "name": "Update User Roles",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"roles\": [\"USER\"]\n}" },
            "url": "{{baseUrl}}/admin/users/{{userId}}/roles"
          }
        },
        { "name": "Permissions", "request": { "method": "GET", "url": "{{baseUrl}}/admin/permissions" } },
        { "name": "Roles", "request": { "method": "GET", "url": "{{baseUrl}}/admin/roles" } },
        { "name": "Role Permissions", "request": { "method": "GET", "url": "{{baseUrl}}/admin/roles/{{roleCode}}/permissions" } },
        { "name": "User Effective Permissions", "request": { "method": "GET", "url": "{{baseUrl}}/admin/users/{{userId}}/permissions" } },
        {
          "name": "Grant Direct User Permission",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"permissionCode\": \"{{permissionCode}}\",\n  \"reason\": \"Granted from Postman\",\n  \"expiresAt\": null\n}" },
            "url": "{{baseUrl}}/admin/users/{{userId}}/permissions"
          }
        }
      ]
    },
    {
      "name": "Admin Coupons Promotions",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
      "item": [
        { "name": "List Coupons", "request": { "method": "GET", "url": "{{baseUrl}}/admin/coupons?page=1&size=20" } },
        {
          "name": "Create Coupon",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const json = pm.response.json();", "if (json && json.data) { if (json.data.id) pm.environment.set('couponId', json.data.id); if (json.data.code) pm.environment.set('couponCode', json.data.code); }"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"code\": \"AIVIRA10\",\n  \"type\": \"PERCENT\",\n  \"value\": 10,\n  \"maxDiscountAmount\": 50000,\n  \"minOrderAmount\": 100000,\n  \"usageLimit\": 100,\n  \"usageLimitPerUser\": 1,\n  \"startAt\": \"2026-06-01T00:00:00\",\n  \"endAt\": \"2026-12-31T23:59:59\",\n  \"active\": true\n}" },
            "url": "{{baseUrl}}/admin/coupons"
          }
        },
        { "name": "Coupon Detail", "request": { "method": "GET", "url": "{{baseUrl}}/admin/coupons/{{couponId}}" } },
        { "name": "List Promotions", "request": { "method": "GET", "url": "{{baseUrl}}/admin/promotions?page=1&size=20" } },
        {
          "name": "Create Promotion",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const json = pm.response.json();", "if (json && json.data && json.data.id) pm.environment.set('promotionId', json.data.id);"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"promotionName\": \"Postman Book Promo\",\n  \"description\": \"Discount created from Postman\",\n  \"promotionType\": \"PERCENT\",\n  \"value\": 15,\n  \"maxDiscountAmount\": 75000,\n  \"promotionScope\": \"PRODUCT\",\n  \"targetId\": {{productId}},\n  \"startAt\": \"2026-06-01T00:00:00\",\n  \"endAt\": \"2026-12-31T23:59:59\",\n  \"active\": true\n}" },
            "url": "{{baseUrl}}/admin/promotions"
          }
        },
        { "name": "Promotion Detail", "request": { "method": "GET", "url": "{{baseUrl}}/admin/promotions/{{promotionId}}" } }
      ]
    },
    {
      "name": "Admin Reviews Dashboard Payments",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
      "item": [
        { "name": "Admin List Reviews", "request": { "method": "GET", "url": "{{baseUrl}}/admin/reviews?page=1&size=20&approved=false&visible=true" } },
        {
          "name": "Moderate Review",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"approved\": true,\n  \"visible\": true\n}" },
            "url": "{{baseUrl}}/admin/reviews/{{reviewId}}/moderate"
          }
        },
        {
          "name": "Reply Review",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"adminReply\": \"Thanks for your feedback.\"\n}" },
            "url": "{{baseUrl}}/admin/reviews/{{reviewId}}/reply"
          }
        },
        { "name": "Dashboard Summary", "request": { "method": "GET", "url": "{{baseUrl}}/admin/dashboard/summary" } },
        { "name": "Dashboard Sales", "request": { "method": "GET", "url": "{{baseUrl}}/admin/dashboard/sales" } },
        { "name": "Dashboard Orders", "request": { "method": "GET", "url": "{{baseUrl}}/admin/dashboard/orders" } },
        { "name": "Dashboard Top Books", "request": { "method": "GET", "url": "{{baseUrl}}/admin/dashboard/top-books?limit=10" } },
        { "name": "Dashboard Low Stock", "request": { "method": "GET", "url": "{{baseUrl}}/admin/dashboard/low-stock?threshold=5&limit=10" } },
        { "name": "Reconcile Payment Group", "request": { "method": "POST", "url": "{{baseUrl}}/admin/payments/groups/{{paymentGroupCode}}/reconcile" } }
      ]
    },
    {
      "name": "Health And Docs",
      "item": [
        { "name": "Health", "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{baseUrl}}/actuator/health" } },
        { "name": "OpenAPI JSON", "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{baseUrl}}/v3/api-docs" } }
      ]
    }
  ]
}
