{
  "info": {
    "_postman_id": "2a1a8df3-3b6f-4cf5-9bb2-aivira-commerce",
    "name": "Aivira Commerce - Cart Address Checkout Payment",
    "description": "Postman collection for Aivira cart, address, checkout, and payment APIs. Import this collection, set variables if needed, then run Login before protected requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": []
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": []
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1",
      "type": "string"
    },
    {
      "key": "username",
      "value": "postman_user",
      "type": "string"
    },
    {
      "key": "password",
      "value": "Password123!",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "productVariationId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "quantity",
      "value": "2",
      "type": "string"
    },
    {
      "key": "cartItemId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "cartItemIdsJson",
      "value": "[1]",
      "type": "string"
    },
    {
      "key": "addressId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "paymentMethod",
      "value": "COD",
      "type": "string"
    },
    {
      "key": "paymentGroupCode",
      "value": "",
      "type": "string"
    },
    {
      "key": "paymentId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "paymentUrl",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login successful', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "if (json && json.data) {",
                  "  if (json.data.token) pm.collectionVariables.set('accessToken', json.data.token);",
                  "  if (json.data.refreshToken) pm.collectionVariables.set('refreshToken', json.data.refreshToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "token"
              ]
            },
            "description": "Returns JWT token. The test script stores `accessToken` for protected requests."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Address",
      "item": [
        {
          "name": "List My Addresses",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/me/addresses",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "me",
                "addresses"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Create Address",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Create address successful', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "if (json && json.data && json.data.id) {",
                  "  pm.collectionVariables.set('addressId', String(json.data.id));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"recipientName\": \"Nguyen Van A\",\n  \"phoneNumber\": \"0900000000\",\n  \"addressLine\": \"123 Nguyen Trai\",\n  \"ward\": \"Phuong 7\",\n  \"district\": \"Quan 5\",\n  \"city\": \"TP. Ho Chi Minh\",\n  \"defaultAddress\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/me/addresses",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "me",
                "addresses"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Update Address",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"recipientName\": \"Nguyen Van A\",\n  \"phoneNumber\": \"0911111111\",\n  \"addressLine\": \"456 Le Loi\",\n  \"ward\": \"Phuong Ben Nghe\",\n  \"district\": \"Quan 1\",\n  \"city\": \"TP. Ho Chi Minh\",\n  \"defaultAddress\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/me/addresses/{{addressId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "me",
                "addresses",
                "{{addressId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Set Default Address",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/me/addresses/{{addressId}}/default",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "me",
                "addresses",
                "{{addressId}}",
                "default"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Delete Address",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/me/addresses/{{addressId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "me",
                "addresses",
                "{{addressId}}"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Cart",
      "item": [
        {
          "name": "Get My Cart",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json && json.data && Array.isArray(json.data.items) && json.data.items.length > 0) {",
                  "  pm.collectionVariables.set('cartItemId', String(json.data.items[0].id));",
                  "  pm.collectionVariables.set('cartItemIdsJson', JSON.stringify(json.data.items.map(item => item.id)));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cart",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cart"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Add Cart Item",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Add item successful', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "if (json && json.data && Array.isArray(json.data.items) && json.data.items.length > 0) {",
                  "  const added = json.data.items.find(item => String(item.productVariationId) === String(pm.collectionVariables.get('productVariationId'))) || json.data.items[0];",
                  "  pm.collectionVariables.set('cartItemId', String(added.id));",
                  "  pm.collectionVariables.set('cartItemIdsJson', JSON.stringify(json.data.items.map(item => item.id)));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productVariationId\": {{productVariationId}},\n  \"quantity\": {{quantity}}\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/cart/items",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cart",
                "items"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Update Cart Item Quantity",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 3\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/cart/items/{{cartItemId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cart",
                "items",
                "{{cartItemId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Remove Cart Item",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cart/items/{{cartItemId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cart",
                "items",
                "{{cartItemId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Clear Cart",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cart/items",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cart",
                "items"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Checkout",
      "item": [
        {
          "name": "Checkout Selected Cart Items",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Checkout successful', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "if (json && json.data) {",
                  "  if (json.data.paymentGroupCode) pm.collectionVariables.set('paymentGroupCode', json.data.paymentGroupCode);",
                  "  if (json.data.paymentUrl) pm.collectionVariables.set('paymentUrl', json.data.paymentUrl);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"addressId\": {{addressId}},\n  \"cartItemIds\": {{cartItemIdsJson}},\n  \"paymentMethod\": \"{{paymentMethod}}\",\n  \"notes\": \"Giao gio hanh chinh\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/checkout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "checkout"
              ]
            },
            "description": "`paymentMethod` supports `COD`, `VNPAY`, and `MOMO`. Use `COD` for the simplest local end-to-end test; online methods require provider configuration."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Payment",
      "item": [
        {
          "name": "Get Payment Group",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json && json.data) {",
                  "  if (json.data.paymentCode) pm.collectionVariables.set('paymentGroupCode', json.data.paymentCode);",
                  "  if (json.data.paymentUrl) pm.collectionVariables.set('paymentUrl', json.data.paymentUrl);",
                  "  if (Array.isArray(json.data.payments) && json.data.payments.length > 0) {",
                  "    pm.collectionVariables.set('paymentId', String(json.data.payments[0].id));",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/payments/groups/{{paymentGroupCode}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments",
                "groups",
                "{{paymentGroupCode}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Payment",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/payments/{{paymentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments",
                "{{paymentId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Retry Payment Group",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/payments/groups/{{paymentGroupCode}}/retry",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments",
                "groups",
                "{{paymentGroupCode}}",
                "retry"
              ]
            },
            "description": "Works only for online payment groups in FAILED, CANCELLED, or EXPIRED status. COD cannot be retried."
          },
          "response": []
        },
        {
          "name": "VNPay Return",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/payments/vnpay/return?vnp_TxnRef={{paymentGroupCode}}&vnp_Amount=10000000&vnp_ResponseCode=00&vnp_TransactionNo=TEST_TXN&vnp_SecureHash=replace_with_valid_hash",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments",
                "vnpay",
                "return"
              ],
              "query": [
                {
                  "key": "vnp_TxnRef",
                  "value": "{{paymentGroupCode}}"
                },
                {
                  "key": "vnp_Amount",
                  "value": "10000000"
                },
                {
                  "key": "vnp_ResponseCode",
                  "value": "00"
                },
                {
                  "key": "vnp_TransactionNo",
                  "value": "TEST_TXN"
                },
                {
                  "key": "vnp_SecureHash",
                  "value": "replace_with_valid_hash"
                }
              ]
            },
            "description": "Public callback endpoint. The sample will fail unless query parameters and signature match the VNPay sandbox payload."
          },
          "response": []
        },
        {
          "name": "VNPay IPN",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/payments/vnpay/ipn?vnp_TxnRef={{paymentGroupCode}}&vnp_Amount=10000000&vnp_ResponseCode=00&vnp_TransactionNo=TEST_TXN&vnp_SecureHash=replace_with_valid_hash",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments",
                "vnpay",
                "ipn"
              ],
              "query": [
                {
                  "key": "vnp_TxnRef",
                  "value": "{{paymentGroupCode}}"
                },
                {
                  "key": "vnp_Amount",
                  "value": "10000000"
                },
                {
                  "key": "vnp_ResponseCode",
                  "value": "00"
                },
                {
                  "key": "vnp_TransactionNo",
                  "value": "TEST_TXN"
                },
                {
                  "key": "vnp_SecureHash",
                  "value": "replace_with_valid_hash"
                }
              ]
            },
            "description": "Public callback endpoint. The sample will fail unless query parameters and signature match the VNPay sandbox payload."
          },
          "response": []
        },
        {
          "name": "MoMo IPN",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"partnerCode\": \"MOMO\",\n  \"orderId\": \"{{paymentGroupCode}}\",\n  \"requestId\": \"{{paymentGroupCode}}\",\n  \"amount\": 100000,\n  \"orderInfo\": \"Aivira order {{paymentGroupCode}}\",\n  \"orderType\": \"momo_wallet\",\n  \"transId\": 123456789,\n  \"resultCode\": 0,\n  \"message\": \"Successful.\",\n  \"payType\": \"qr\",\n  \"responseTime\": 1766558400000,\n  \"extraData\": \"\",\n  \"signature\": \"replace_with_valid_signature\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/payments/momo/ipn",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments",
                "momo",
                "ipn"
              ]
            },
            "description": "Public callback endpoint. The sample will fail unless body and signature match the MoMo sandbox payload."
          },
          "response": []
        }
      ]
    }
  ]
}
